# Live ERP origin (no trailing slash). The connector calls /api/tally-connector/...
ERP_BASE_URL=https://erp.paramgold.in

# Sanctum token from: php artisan tally-connector:issue-token --user-id=YOUR_ADMIN_USER_ID
# Never commit this value.
ERP_CONNECTOR_TOKEN=

# Optional. Identifies this office PC on claim. Default is the Windows computer name.
CONNECTOR_ID=

# Seconds between ERP polls
POLL_INTERVAL_SECONDS=30

# How many pending vouchers to fetch per poll (max 50)
PENDING_LIMIT=10

# Tally Prime HTTP server on this PC
TALLY_URL=http://localhost:9000

# Exact company name as shown in Tally Prime. Leave blank to use the currently open company.
TALLY_COMPANY=

# Tally voucher type names (must already exist in the company)
TALLY_VOUCHER_TYPE_SALES=Sales
TALLY_VOUCHER_TYPE_RECEIPT=Receipt

# Existing Tally accounting ledgers (must already exist). Dealer/party ledgers are NEVER created.
TALLY_SALES_LEDGER=Sales
TALLY_GST_LEDGER=GST
TALLY_ROUND_OFF_LEDGER=Round Off
TALLY_CASH_LEDGER=Cash
TALLY_BANK_LEDGER=Bank
