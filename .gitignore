backend/storage/framework/sessions/*
!backend/storage/framework/sessions/.gitignore
backend/storage/framework/views/*
!backend/storage/framework/views/.gitignore
backend/public/storage
backend/public/hot
backend/public/build
backend/bootstrap/cache/*
!backend/bootstrap/cache/.gitignore

# Flutter (mobile)
mobile/.dart_tool/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.pub-cache/
mobile/.pub/
mobile/android/.gradle/
mobile/android/local.properties
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/.last_build_id

# Tally connector (office PC)
tally-connector/.env
tally-connector/__pycache__/
tally-connector/*.pyc

# Secrets and signing
*.jks
*.keystore
key.properties
google-services.json
GoogleService-Info.plist

# IDE
.vscode/
.idea/
*.iml
*.ipr
*.iws

# OS
.DS_Store
Thumbs.db
desktop.ini

# Gradle (local caches outside mobile/android)
.gradle/

