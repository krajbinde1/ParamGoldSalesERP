APP_NAME="ParamGold ERP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://erp.paramgold.in

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Production database (Hostinger MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=erp.paramgold.in
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log

# Uploaded files (employee photos, attendance, collections, etc.) use the public disk.
FILESYSTEM_DISK=public

QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@paramgold.in"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Sanctum / API
SANCTUM_STATEFUL_DOMAINS=erp.paramgold.in

# Firebase Cloud Messaging (order push notifications)
# Place service-account JSON at storage/app/firebase-service-account.json
FIREBASE_PUSH_ENABLED=true
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

# Payment Request approvers (prefer stable user IDs; names used only for lookup fallback)
PAYMENT_REQUEST_FIRST_APPROVER_USER_ID=
PAYMENT_REQUEST_SECOND_APPROVER_USER_ID=
PAYMENT_REQUEST_FIRST_APPROVER_NAME="Bhagwan Kakde"
PAYMENT_REQUEST_SECOND_APPROVER_NAME="Krishna Rajbinde"

VITE_APP_NAME="${APP_NAME}"
